        <!-- KUBERNETES VPC CLUSTER -->
        <mxCell id="k8s_c" value="KUBERNETES ISOLATED CLUSTER VPC (Kind Single-Node VPC: 10.244.0.0/16)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0f172a;strokeWidth=2;fontColor=#0f172a;fontSize=12;fontStyle=1;" vertex="1" parent="1">
