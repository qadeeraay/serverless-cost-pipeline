        <mxCell id="e_async_lbl" value="1B. Async PUT uploads/raw.jpg" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9.5;fontStyle=1;fontColor=#92400e;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e_async">
