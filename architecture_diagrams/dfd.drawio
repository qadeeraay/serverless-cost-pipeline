        <mxCell id="e_bridge_nats_lbl" value="2. s3:ObjectCreated" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontStyle=1;fontColor=#92400e;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e_bridge_nats">
          <mxGeometry x="-0.1" y="2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
