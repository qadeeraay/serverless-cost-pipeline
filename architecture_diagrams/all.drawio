          <mxGeometry x="30" y="160" width="500" height="340" as="geometry" />
        </mxCell>

        <mxCell id="pw" value="&lt;b&gt;Golang of-watchdog HTTP Reverse Proxy (:8080)&lt;/b&gt;&lt;br&gt;Manages HTTP sockets, child Python processes, and 10s execution timeouts (9MB RAM baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=9.5;" vertex="1" parent="podg">
          <mxGeometry x="15" y="35" width="470" height="40" as="geometry" />
        </mxCell>

        <mxCell id="ps" value="&lt;b&gt;Zero-Trust Security Filter Layer (handler.py)&lt;/b&gt;&lt;br&gt;• 16-Byte Cryptographic Magic Header Check (\x89PNG, \xff\xd8, RIFF) ➔ HTTP 422&lt;br&gt;• 30MP Anti-Decompression Bomb Ceiling (MAX_IMAGE_PIXELS) ➔ HTTP 413&lt;br&gt;• Pre-Compiled Object Key Traversal Sanitizer (Regex ^[a-zA-Z0-9_\-\./]+$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=9.5;align=left;" vertex="1" parent="podg">
          <mxGeometry x="15" y="85" width="470" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pe" value="&lt;b&gt;Python 3.12 + C-Libwebp Transcoding Engine&lt;/b&gt;&lt;br&gt;• Single-Pass In-Memory Transcoding (quality=80, method=4) ➔ 45.18% Bandwidth Savings&lt;br&gt;• In-Place EXIF Privacy Sanitizer (GPS coordinates, camera serials, timestamps scrubbed)&lt;br&gt;• In-Memory SHA-256 ETag Micro-Cache (1.2ms response with $0.00 compute spend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=9.5;align=left;" vertex="1" parent="podg">
          <mxGeometry x="15" y="160" width="470" height="65" as="geometry" />
        </mxCell>

        <mxCell id="pr" value="&lt;b&gt;Ephemeral 32MB tmpfs RAM Disk Scratchpad (/tmp)&lt;/b&gt;&lt;br&gt;Mounted emptyDir: { medium: Memory } | ZERO Physical Disk I/O (&gt;20 GB/s RAM speed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=9.5;fontStyle=1;" vertex="1" parent="podg">
          <mxGeometry x="15" y="235" width="470" height="40" as="geometry" />
        </mxCell>

        <mxCell id="pc" value="&lt;b&gt;Linux Security Context:&lt;/b&gt; readOnlyRootFilesystem: true | runAsNonRoot: UID 1000 | drop: ['ALL'] | seccomp: RuntimeDefault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0f172a;fontColor=#ffffff;fontSize=9;" vertex="1" parent="podg">
          <mxGeometry x="15" y="285" width="470" height="40" as="geometry" />
        </mxCell>

        <!-- STORAGE & OBSERVABILITY TIER -->
        <mxCell id="sg" value="STORAGE &amp; OBSERVABILITY TIER" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="k8s_c">
          <mxGeometry x="560" y="160" width="250" height="340" as="geometry" />
        </mxCell>
        <mxCell id="ms3" value="&lt;b&gt;MinIO S3 Object Storage (:9000)&lt;/b&gt;&lt;br&gt;• Bucket 'uploads/' (Raw Images)&lt;br&gt;• Bucket 'processed/' (WebP)&lt;br&gt;• Zero Public Cloud Egress Fees ($0)&lt;br&gt;• Persistent Local Volume (PV/PVC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=9.5;" vertex="1" parent="sg">
          <mxGeometry x="15" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="otb" value="&lt;b&gt;OpenTelemetry W3C Tracing&lt;/b&gt;&lt;br&gt;• Injects traceparent (00-...-01)&lt;br&gt;• Discrete Sub-ms Spans:&lt;br&gt;  - S3 Fetch (2.57ms)&lt;br&gt;  - C-Libwebp Transcode (1.20ms)&lt;br&gt;  - S3 Persist (1.03ms)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontSize=9.5;align=left;" vertex="1" parent="sg">
          <mxGeometry x="15" y="130" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="csb" value="&lt;b&gt;Cosign &amp; Kyverno Admission&lt;/b&gt;&lt;br&gt;• ECDSA NIST P-256 Digital Signature&lt;br&gt;• Cryptographic Image Digest Check&lt;br&gt;• Blocks Untrusted / Tampered Images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=9.5;" vertex="1" parent="sg">
          <mxGeometry x="15" y="235" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- FINOPS SCORECARD FOOTER -->
