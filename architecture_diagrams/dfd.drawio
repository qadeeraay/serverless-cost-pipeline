        <mxCell id="e_nats_conn_lbl" value="3. Pull Batch" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#92400e;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e_nats_conn">
          <mxGeometry x="-0.1" y="2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
        </mxCell>

        <!-- Path 1F: Connector -> DLQ on 3 failures -->
        <mxCell id="e_conn_dlq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;" edge="1" source="p_conn" target="ds_dlq" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
