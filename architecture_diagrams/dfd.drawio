  <diagram id="comprehensive_dfd" name="Data Flow Diagram (Sync, Async &amp; Velero DR)">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ========================================================================= -->
        <!-- HEADER                                                                    -->
        <!-- ========================================================================= -->
        <mxCell id="title" value="DATA FLOW DIAGRAM (DFD) — SYNCHRONOUS, ASYNCHRONOUS EVENT-DRIVEN &amp; VELERO DISASTER RECOVERY PIPELINE&#xa;Maintainer: Qadeer Aslam (qadeer016) | Enterprise Cloud-Native Serverless &amp; FinOps Specification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#ffffff;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1270" height="50" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- 1. SOURCE ENTITY: CLIENT & LOAD GENERATOR                                 -->
        <!-- ========================================================================= -->
        <mxCell id="client" value="&lt;font size='3'&gt;&lt;b&gt;Client / Producer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;(CLI / Web Upload /&lt;br&gt;Load Generator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- ASYNC INGESTION & NATS QUEUE PATH                                         -->
        <!-- ========================================================================= -->
        <mxCell id="p_bridge" value="&lt;b&gt;1. S3 Event Bridge&lt;/b&gt;&lt;br&gt;MinIO emits s3:ObjectCreated&lt;br&gt;event notification" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="90" width="165" height="85" as="geometry" />
        </mxCell>

        <mxCell id="nats_queue" value="&lt;b&gt;2. NATS JetStream Broker&lt;/b&gt;&lt;br&gt;(:4222 Message Bus in 'nats' NS)&lt;br&gt;&lt;font color='#92400e'&gt;Stream: S3-EVENTS | Persistent WAL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="90" width="200" height="85" as="geometry" />
        </mxCell>

        <mxCell id="p_conn" value="&lt;b&gt;3. Pull Connector&lt;/b&gt;&lt;br&gt;Durable consumer in openfaas-fn&lt;br&gt;3 Retries ➔ Routes to DLQ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="90" width="175" height="85" as="geometry" />
        </mxCell>

        <mxCell id="ds_dlq" value="&lt;b&gt;Dead-Letter Queue (DLQ-POISON)&lt;/b&gt;&lt;br&gt;(s3.events.dlq | 30-Day TTL)" style="html=1;dashed=0;whiteSpace=wrap;shape=partialRectangle;right=0;left=0;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="10" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- CORE PROCESSING PIPELINE                                                  -->
        <!-- ========================================================================= -->
        <!-- PROCESS 1: VALIDATE -->
        <mxCell id="p1" value="&lt;b&gt;4. Gateway &amp; Validate&lt;/b&gt;&lt;br&gt;16B Magic Bytes, 10MB Cap,&lt;br&gt;&amp; 30MP Decompression Cap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="165" height="95" as="geometry" />
        </mxCell>

        <!-- PROCESS 2: CHECK CACHE -->
        <mxCell id="p2" value="&lt;b&gt;5. Check Cache&lt;/b&gt;&lt;br&gt;SHA-256 Hash Match?" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="495" y="220" width="165" height="95" as="geometry" />
        </mxCell>

        <!-- DATA STORE: RAM CACHE -->
        <mxCell id="ds_ram" value="&lt;b&gt;RAM Micro-Cache &amp; tmpfs Disk&lt;/b&gt;&lt;br&gt;(SHA-256 Key Store in /tmp 32MB tmpfs)" style="html=1;dashed=0;whiteSpace=wrap;shape=partialRectangle;right=0;left=0;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=2;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="475" y="370" width="205" height="45" as="geometry" />
        </mxCell>

        <!-- PROCESS 3: TRANSCODE -->
        <mxCell id="p3" value="&lt;b&gt;6. Transcode &amp; Strip&lt;/b&gt;&lt;br&gt;Pillow WebP (method=0)&lt;br&gt;&amp; Strip EXIF GPS Privacy" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#22c55e;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="220" width="165" height="95" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- DESTINATION DATA STORE: MINIO S3                                          -->
        <!-- ========================================================================= -->
        <mxCell id="ds_s3" value="&lt;b&gt;MinIO S3 Storage (Namespace: 'minio')&lt;/b&gt;&lt;br&gt;• Bucket 'uploads/' (Raw Images)&lt;br&gt;• Bucket 'processed/' (WebP Output)&lt;br&gt;• Bucket 'velero-backups/' (DR Tarballs)" style="html=1;dashed=0;whiteSpace=wrap;shape=partialRectangle;right=0;left=0;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="240" height="95" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- DISASTER RECOVERY: VELERO S3 CONTROLLER                                   -->
        <!-- ========================================================================= -->
        <mxCell id="p_velero" value="&lt;b&gt;7. Velero DR Controller&lt;/b&gt;&lt;br&gt;Daily Cron '0 2 * * *' (30d TTL)&lt;br&gt;Snapshots K8s state &amp; WAL streams" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=10.5;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="975" y="85" width="210" height="90" as="geometry" />
        </mxCell>

        <!-- ========================================================================= -->
        <!-- CONNECTORS & FLOWS                                                        -->
        <!-- ========================================================================= -->

        <!-- Path 1A: Sync Upload -> Gateway/Validate -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2.5;" edge="1" source="client" target="p1" parent="1">
