        <mxCell id="e_conn_p1_lbl" value="Forward Ingestion CloudEvent" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#15803d;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e_conn_p1">
