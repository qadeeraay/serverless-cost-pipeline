        <mxCell id="e_202_lbl" value="HTTP 202 Accepted (52.9ms Non-Blocking)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9.5;fontStyle=1;fontColor=#92400e;backgroundColor=#ffffff;" vertex="1" connectable="0" parent="e_202">
          <mxGeometry x="-0.1" y="2" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry>
