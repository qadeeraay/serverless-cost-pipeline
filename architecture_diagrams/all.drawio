        <!-- INGRESS & MESSAGING TIER (openfaas & nats) -->
        <mxCell id="gwb" value="&lt;b&gt;OpenFaaS Ingress Gateway (:8080)&lt;/b&gt;&lt;br&gt;• Namespace: openfaas&lt;br&gt;• Basic-Auth &amp; JWT Verification&lt;br&gt;• Reverse Proxy &amp; Rate-Limiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=10;strokeWidth=2;" vertex="1" parent="k8s_c">
          <mxGeometry x="25" y="35" width="225" height="85" as="geometry" />
        </mxCell>
        <mxCell id="idlerb" value="&lt;b&gt;FinOps Auto-Idler Governor&lt;/b&gt;&lt;br&gt;• Namespace: openfaas&lt;br&gt;• 20s Inactivity Tracking&lt;br&gt;• Scale-to-Zero ($0.00 Idle Spend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;fontSize=10;strokeWidth=1.5;" vertex="1" parent="k8s_c">
          <mxGeometry x="270" y="35" width="225" height="85" as="geometry" />
        </mxCell>
        <mxCell id="natsb" value="&lt;b&gt;NATS JetStream Broker (:4222)&lt;/b&gt;&lt;br&gt;• Namespace: nats (Persistent WAL)&lt;br&gt;• Stream: 'S3-EVENTS' (s3.events.uploads)&lt;br&gt;• Returns HTTP 202 in 52.9ms (Non-Blocking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=10;strokeWidth=2;" vertex="1" parent="k8s_c">
          <mxGeometry x="515" y="35" width="235" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dlqb" value="&lt;b&gt;Dead-Letter Queue (DLQ-POISON)&lt;/b&gt;&lt;br&gt;• Subject: s3.events.dlq&lt;br&gt;• 30-Day TTL (--max-age=720h)&lt;br&gt;• Isolates Corrupt Payloads &amp; Failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=10;strokeWidth=1.5;" vertex="1" parent="k8s_c">
          <mxGeometry x="770" y="35" width="225" height="85" as="geometry" />
        </mxCell>

        <!-- STATELESS COMPUTE FLEET (openfaas-fn) -->
        <mxCell id="podg" value="STATELESS FAAS COMPUTE POD FLEET (Namespace: openfaas-fn)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="k8s_c">
          <mxGeometry x="25" y="135" width="510" height="385" as="geometry" />
        </mxCell>
        <mxCell id="conn_pod" value="&lt;b&gt;Pod: nats-openfaas-connector&lt;/b&gt;&lt;br&gt;Durable pull subscriber ('openfaas-image-processor-consumer') | 5s AckWait | 3 Retries ➔ Routes to DLQ-POISON on failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontSize=9.5;" vertex="1" parent="podg">
          <mxGeometry x="15" y="30" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pw" value="&lt;b&gt;Golang of-watchdog HTTP Reverse Proxy (:8080)&lt;/b&gt;&lt;br&gt;Manages HTTP sockets, child Python processes, and 10s execution timeouts (9MB RAM baseline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=9.5;" vertex="1" parent="podg">
          <mxGeometry x="15" y="78" width="480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ps" value="&lt;b&gt;Zero-Trust Security Filter Layer (handler.py)&lt;/b&gt;&lt;br&gt;• 16-Byte Cryptographic Magic Header Check (\x89PNG, \xff\xd8, RIFF) ➔ HTTP 422&lt;br&gt;• 30MP Anti-Decompression Bomb Ceiling (MAX_IMAGE_PIXELS) ➔ HTTP 413&lt;br&gt;• Pre-Compiled Object Key Traversal Sanitizer (Regex ^[a-zA-Z0-9_\-\./]+$)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#ef4444;fontSize=9.5;align=left;" vertex="1" parent="podg">
          <mxGeometry x="15" y="120" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pe" value="&lt;b&gt;Python 3.12 + C-Libwebp Transcoding Engine&lt;/b&gt;&lt;br&gt;• Single-Pass In-Memory Transcoding (quality=65, method=0 C-Libwebp) ➔ 58.98% Bandwidth Savings&lt;br&gt;• In-Place EXIF Privacy Sanitizer (GPS coordinates, camera serials, timestamps scrubbed)&lt;br&gt;• In-Memory SHA-256 ETag Micro-Cache (1.2ms response with $0.00 compute spend)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontSize=9.5;align=left;" vertex="1" parent="podg">
          <mxGeometry x="15" y="188" width="480" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pr" value="&lt;b&gt;Ephemeral 32MB tmpfs RAM Disk Scratchpad (/tmp)&lt;/b&gt;&lt;br&gt;Mounted emptyDir: { medium: Memory } | ZERO Physical Disk I/O (&gt;20 GB/s RAM speed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontSize=9.5;fontStyle=1;" vertex="1" parent="podg">
          <mxGeometry x="15" y="255" width="480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="&lt;b&gt;Linux Security Context:&lt;/b&gt; readOnlyRootFilesystem: true | runAsNonRoot: UID 1000 | drop: ['ALL'] | seccomp: RuntimeDefault" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#0f172a;fontColor=#ffffff;fontSize=9;" vertex="1" parent="podg">
          <mxGeometry x="15" y="298" width="480" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hpab" value="&lt;b&gt;Kubernetes HPA v2 Autoscaler:&lt;/b&gt; 1 ➔ 5 Replicas | Target: &gt;10% CPU | Rapid Cooldown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#ec4899;fontSize=9.5;fontStyle=1;" vertex="1" parent="podg">
          <mxGeometry x="15" y="340" width="480" height="32" as="geometry" />
        </mxCell>

        <!-- STORAGE & OBSERVABILITY TIER (minio & velero) -->
        <mxCell id="sg" value="STORAGE &amp; DISASTER RECOVERY TIER (Namespace: minio &amp; velero)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;fontSize=11;fontStyle=1;" vertex="1" parent="k8s_c">
          <mxGeometry x="555" y="135" width="440" height="385" as="geometry" />
        </mxCell>
        <mxCell id="ms3" value="&lt;b&gt;MinIO S3 Object Storage (:9000 &amp; :9001)&lt;/b&gt;&lt;br&gt;• Namespace: minio (Local PVC Persistent Volume)&lt;br&gt;• Bucket 'uploads/' (Raw Client Ingestion)&lt;br&gt;• Bucket 'processed/' (Transcoded WebP Artifacts)&lt;br&gt;• Bucket 'velero-backups/' (Cluster Disaster Recovery)&lt;br&gt;• S3 Event Notification Hook: s3:ObjectCreated:Put ➔ NATS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=9.5;align=left;" vertex="1" parent="sg">
          <mxGeometry x="15" y="30" width="410" height="90" as="geometry" />
        </mxCell>
        <mxCell id="velerob" value="&lt;b&gt;Velero Disaster Recovery Controller (Namespace: velero)&lt;/b&gt;&lt;br&gt;• Velero Server v1.15.2 + AWS S3 Provider Plugin v1.11.0&lt;br&gt;• Automated Daily Cron Schedule: '0 2 * * *' (30-Day Retention TTL: 720h)&lt;br&gt;• Snapshot Scope: openfaas, openfaas-fn, nats, minio (RTO &lt;15m, RPO &lt;1m)&lt;br&gt;• Target Backup Storage: minio://velero-backups" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=9.5;align=left;" vertex="1" parent="sg">
          <mxGeometry x="15" y="130" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="otb" value="&lt;b&gt;OpenTelemetry W3C Tracing &amp; Prometheus Telemetry&lt;/b&gt;&lt;br&gt;• Injects traceparent: 00-&lt;trace_id&gt;-&lt;span_id&gt;-01&lt;br&gt;• Discrete Sub-ms Spans: S3 Fetch (2.57ms), Transcode (1.20ms), S3 Persist (1.03ms)&lt;br&gt;• Prometheus scraper on :8080/metrics feeds HPA auto-scaler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontSize=9.5;align=left;" vertex="1" parent="sg">
          <mxGeometry x="15" y="225" width="410" height="75" as="geometry" />
        </mxCell>
        <mxCell id="csb" value="&lt;b&gt;DevSecOps Governance (Cosign ECDSA + NetworkPolicy)&lt;/b&gt;&lt;br&gt;• Cosign ECDSA NIST P-256 Signature Verification on Container Digest&lt;br&gt;• NetworkPolicy isolate-function-traffic (Ingress: 8080, Egress: 9000 &amp; 53 ONLY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=9.5;align=left;" vertex="1" parent="sg">
          <mxGeometry x="15" y="310" width="410" height="60" as="geometry" />
        </mxCell>

        <!-- FINOPS SCORECARD FOOTER -->
        <mxCell id="ff" value="&lt;b&gt;FINOPS METRICS &amp; UNIT ECONOMICS:&lt;/b&gt; Scale-to-Zero ($0.00 Idle Spend) | 99.8% Cost Reduction vs EC2 VM ($0.06 vs $30.36 / 1M Images) | Sustained Peak: 248.2 req/sec | Median Latency: 18.5ms | Velero Backup Verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;fontColor=#38bdf8;fontSize=10.5;fontStyle=1;align=center;" vertex="1" parent="k8s_c">
          <mxGeometry x="25" y="535" width="970" height="40" as="geometry" />
        </mxCell>

        <!-- CONNECTORS & FLOWS -->
        <!-- 1. Sync Upload: Client CLI -> Gateway -->
        <mxCell id="ee1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563eb;strokeWidth=2;" edge="1" source="c_cli" target="gwb" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <!-- 2. Async Upload: Client -> MinIO uploads/ -->
        <mxCell id="ee_async_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" source="c_s3" target="ms3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="460" />
              <mxPoint x="270" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 3. MinIO Event Hook -> NATS JetStream -->
        <mxCell id="ee_minio_nats" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" source="ms3" target="natsb" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 4. NATS JetStream -> Pull Connector -->
        <mxCell id="ee_nats_conn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#f59e0b;strokeWidth=2;" edge="1" source="natsb" target="conn_pod" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 5. Connector -> Gateway Trigger -->
        <mxCell id="ee_conn_gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;" edge="1" source="conn_pod" target="gwb" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 6. Connector -> DLQ on 3 failures -->
        <mxCell id="ee_conn_dlq" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;dashed=1;" edge="1" source="conn_pod" target="dlqb" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 7. Gateway -> Watchdog Pod -->
        <mxCell id="ee_gw_pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=2;" edge="1" source="gwb" target="pw" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 8. Pod -> MinIO processed/ -->
        <mxCell id="ee_pod_minio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=2;" edge="1" source="pe" target="ms3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 9. Velero DR Snapshot -> MinIO velero-backups -->
        <mxCell id="ee_velero_minio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16a34a;strokeWidth=2.5;" edge="1" source="velerob" target="ms3" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- 10. Auto-Idler -> Pod Scale-to-Zero -->
        <mxCell id="ee_idler_pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#22c55e;strokeWidth=1.5;dashed=1;" edge="1" source="idlerb" target="podg" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

